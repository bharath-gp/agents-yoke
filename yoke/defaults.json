{
  "roles": {
    "primary": "claude",
    "secondary": "agy",
    "by_role": {
      "requirements": "primary",
      "planner": "primary",
      "wayfinder": "primary",
      "orchestrator": "primary",
      "plan_review": "secondary",
      "code": "secondary",
      "review": "auto",
      "qa": "secondary",
      "validate": "primary",
      "docs": "secondary",
      "search": "primary",
      "research": "secondary",
      "factcheck": "primary",
      "pr_body": "primary"
    }
  },
  "models": {},
  "max_attempts_per_ticket": 3,
  "max_plan_review_rounds": 3,
  "max_review_rounds": 2,
  "max_fix_tickets_per_milestone": 2,
  "max_chart_rounds": 3,
  "max_tickets": 40,
  "max_agent_calls_total": 300,
  "budget": {
    "max_cost_usd": null,
    "max_tokens": null
  },
  "limits": {
    "patterns": {
      "claude": [
        "(?i)rate[ _]?limit",
        "(?i)quota[ _]?exceeded",
        "(?i)usage[ _]?limit",
        "(?i)too many requests",
        "(?i)overloaded_error",
        "(?i)credit balance"
      ],
      "agy": [
        "(?i)resource_exhausted",
        "(?i)rate[ _]?limit",
        "(?i)quota[ _]?exceeded",
        "(?i)too many requests"
      ]
    },
    "max_wait_s": 7200,
    "max_waits": 3
  },
  "parallel": 1,
  "timeouts_s": {
    "plan_review": 900,
    "code": 2400,
    "review": 1200,
    "qa": 1800,
    "validate": 1200,
    "docs": 900,
    "search": 600,
    "research": 1800,
    "factcheck": 1200,
    "router_fallback": 120,
    "pr_body": 300,
    "wayfinder": 1200
  },
  "kill_grace_s": 15,
  "router": {
    "ollama_url": "http://127.0.0.1:11434",
    "model": "tev1:4b",
    "llm_model": "claude-haiku-5-5",
    "min_confidence": 0.7,
    "fallback": {"agent": "claude", "model": "claude-haiku-5-5", "effort": "low"}
  },
  "test_command": null,
  "tracker": "auto",
  "agents": {
    "claude": {
      "write_allowed_tools": ["Read", "Edit", "Write", "Grep", "Glob", "Bash(ls:*)", "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)"]
    },
    "agy": {}
  },
  "search": {
    "tools": ["WebSearch", "WebFetch", "Skill", "mcp__firecrawl"]
  },
  "research": {
    "default_depth": "normal",
    "doc_dir": "docs/research",
    "depths": {
      "quick": {"max_sources": 5, "search_rounds": 1},
      "normal": {"max_sources": 12, "search_rounds": 2},
      "deep": {"max_sources": 25, "search_rounds": 4}
    }
  },
  "routing": {
    "feature": {"stages": ["code", "review", "qa", "validate", "docs"]},
    "bugfix": {"stages": ["code", "review", "qa", "validate", "docs"]},
    "refactor": {"stages": ["code", "review", "qa", "validate"]},
    "test": {"stages": ["qa", "validate"]},
    "docs": {"stages": ["docs", "validate"]},
    "chore": {"stages": ["code", "review", "validate"]},
    "spike": {"stages": ["code", "review", "validate"]},
    "research": {"stages": ["search", "research", "factcheck"]}
  }
}
