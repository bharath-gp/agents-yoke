{
  "roles": {
    "primary": "claude",
    "secondary": "agy",
    "by_role": {
      "requirements": "primary",
      "planner": "primary",
      "wayfinder": "primary",
      "orchestrator": "primary",
      "plan_review": "secondary",
      "code": "secondary",
      "review": "auto",
      "qa": "secondary",
      "validate": "primary",
      "docs": "secondary",
      "search": "primary",
      "research": "secondary",
      "factcheck": "primary",
      "pr_body": "primary",
      "hypotheses": "secondary",
      "hypotheses_rank": "primary",
      "e2e": "primary"
    }
  },
  "models": {},
  "max_attempts_per_ticket": 3,
  "max_plan_review_rounds": 3,
  "max_review_rounds": 2,
  "max_test_fix_rounds": 2,
  "review_lenses": [
    "security",
    "performance",
    "tests"
  ],
  "hypotheses": 0,
  "max_fix_tickets_per_milestone": 2,
  "max_chart_rounds": 3,
  "max_tickets": 40,
  "max_agent_calls_total": 300,
  "budget": {
    "max_cost_usd": null,
    "max_tokens": null
  },
  "limits": {
    "patterns": {
      "claude": [
        "(?i)rate[ _]?limit",
        "(?i)quota[ _]?exceeded",
        "(?i)usage[ _]?limit",
        "(?i)too many requests",
        "(?i)overloaded_error",
        "(?i)credit balance"
      ],
      "agy": [
        "(?i)resource_exhausted",
        "(?i)rate[ _]?limit",
        "(?i)quota[ _]?exceeded",
        "(?i)too many requests"
      ]
    },
    "max_wait_s": 7200,
    "max_waits": 3,
    "backoff_s": 30
  },
  "parallel": 1,
  "timeouts_s": {
    "plan_review": 900,
    "code": 2400,
    "review": 1200,
    "qa": 1800,
    "validate": 1200,
    "docs": 900,
    "search": 600,
    "research": 1800,
    "factcheck": 1200,
    "router_fallback": 120,
    "pr_body": 300,
    "wayfinder": 1200,
    "gate_hook": 300,
    "hypotheses": 600,
    "e2e": 900,
    "test": 600
  },
  "kill_grace_s": 15,
  "router": {
    "ollama_url": "http://127.0.0.1:11434",
    "model": "tev1:4b",
    "llm_model": "claude-haiku-5-5",
    "min_confidence": 0.7,
    "thresholds": {
      "safety": 0.7,
      "test_failure": 0.7,
      "after_failure": 0.85,
      "gate_failure": 0.85,
      "validator_reject": 0.75,
      "model_tier": 0.7,
      "effort": 0.7,
      "skill": 0.6,
      "e2e_pick": 0.6,
      "e2e_verdict": 0.8
    },
    "retry_bump": true,
    "fallback": {"agent": "claude", "model": "claude-haiku-5-5", "effort": "low"}
  },
  "test_command": null,
  "notify_command": null,
  "tracker": "auto",
  "agents": {
    "claude": {
      "write_allowed_tools": ["Read", "Edit", "Write", "Grep", "Glob", "Bash(ls:*)", "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)"],
      "setting_sources": "project,local"
    },
    "agy": {}
  },
  "search": {
    "tools": ["WebSearch", "WebFetch", "Skill", "mcp__firecrawl"]
  },
  "research": {
    "default_depth": "normal",
    "doc_dir": "docs/research",
    "depths": {
      "quick": {"max_sources": 5, "search_rounds": 1},
      "normal": {"max_sources": 12, "search_rounds": 2},
      "deep": {"max_sources": 25, "search_rounds": 4}
    }
  },
  "routing": {
    "feature": {"stages": ["code", "review", "qa", "validate", "docs"]},
    "bugfix": {"stages": ["code", "review", "qa", "validate", "docs"]},
    "refactor": {"stages": ["code", "review", "qa", "validate"]},
    "test": {"stages": ["qa", "validate"]},
    "docs": {"stages": ["docs", "validate"]},
    "chore": {"stages": ["code", "review", "validate"]},
    "spike": {"stages": ["code", "review", "validate"]},
    "research": {"stages": ["search", "research", "factcheck"]}
  },
  "gate_hooks": {
    "after_stage": {
      "code": [],
      "qa": []
    },
    "before_close": []
  },
  "guard": {
    "enabled": true,
    "chat_hook": true,
    "ask_floor": 0.4,
    "ollama_timeout_s": 5,
    "max_deleted_lines": 500,
    "fast_allow_tools": [
      "Read",
      "Grep",
      "Glob"
    ],
    "deny_paths": [
      ".env*",
      "~/.ssh/*",
      "~/.aws/*",
      "*.pem",
      "*.key",
      ".git/hooks/*"
    ],
    "deny_commands": [
      "(?i)rm\\s+-rf?\\s+",
      "(?i)(curl|wget)\\b.*\\|\\s*(ba)?sh",
      "(?i)curl\\b.*-d\\s*@",
      "(?i)\\b(scp|nc)\\b"
    ],
    "secret_patterns": [
      "(?i)AKIA[0-9A-Z]{16}",
      "-----BEGIN [A-Z ]*PRIVATE KEY-----",
      "(?i)gh[pousr]_[A-Za-z0-9_]{36,}"
    ],
    "sensitive_files": [
      ".env*",
      "~/.ssh/*",
      "~/.aws/*",
      "*.pem",
      "*.key",
      ".git/hooks/*"
    ],
    "grey_files": [
      ".github/workflows/*",
      ".gitlab-ci.yml",
      ".githooks/*"
    ],
    "network_patterns": [
      "(?i)\\b(curl|wget|scp|nc|ssh|rsync|requests)\\b"
    ]
  },
  "skills": {
    "allowlist": [],
    "max": 3,
    "agy_mode": "inline",
    "inline_chars": 4000,
    "roots": []
  },
  "e2e": {
    "url": null,
    "start_command": null,
    "ready_timeout_s": 60,
    "max_steps": 12,
    "candidates": 20
  }
}
