{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "type",
    "description",
    "exit_criteria",
    "depends_on",
    "files_hint",
    "plan_excerpt",
    "milestone"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[TF]-\\d{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "feature",
        "bugfix",
        "refactor",
        "test",
        "docs",
        "chore",
        "spike",
        "research"
      ]
    },
    "description": {
      "type": "string"
    },
    "exit_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files_hint": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "plan_excerpt": {
      "type": "string"
    },
    "milestone": {
      "type": "string",
      "pattern": "^MS-\\d{2}$"
    },
    "notes": {
      "type": "string"
    },
    "doc_path": {
      "type": "string"
    }
  }
}
